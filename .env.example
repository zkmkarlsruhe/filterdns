# FilterDNS Configuration
# Copy this file to .env and customize

# Database connection
DATABASE_URL=postgresql://filterdns:changeme@localhost:5432/filterdns

# Domain for DNS endpoints (change to your actual domain)
FILTERDNS_DOMAIN=filterdns.example.com

# Admin password for web UI (minimum 8 characters)
FILTERDNS_ADMIN_PASSWORD=changeme_admin_password

# Upstream DNS servers (comma-separated)
FILTERDNS_UPSTREAM_DNS=1.1.1.1,8.8.8.8

# Debug mode (true/false)
FILTERDNS_DEBUG=false

# Optional: PTR lookup server for reverse DNS
# FILTERDNS_PTR_SERVER=your-dns-server.local

# Optional: TLS certificate paths (for DoH and DoT)
# FILTERDNS_TLS_CERT=./certs/cert.pem
# FILTERDNS_TLS_KEY=./certs/key.pem

# Optional: Skip loading blocklists on startup (for faster dev)
# SKIP_BLOCKLISTS=1
