# FilterDNS Configuration
# Copy this file to .env and customize

# Database
DB_PASSWORD=changeme_strong_password

# Domain
FILTERDNS_DOMAIN=filterdns.zkm.de

# Admin password for web UI
ADMIN_PASSWORD=changeme_admin_password

# Debug mode (true/false)
DEBUG=false

# Optional: PTR lookup server for reverse DNS
# FILTERDNS_PTR_SERVER=infoblox.zkm.de

# Optional: TLS certificate paths (for DoH and DoT)
# Mount certificates in ./certs directory:
# - ./certs/cert.pem (certificate chain)
# - ./certs/key.pem (private key)
